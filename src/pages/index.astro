---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import ProjectsSlider from '../components/ProjectsSlider.astro';
import SocialProjects from '../components/SocialProjects.astro';
import AboutImpact from '../components/AboutImpact.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
---

<Layout title={SITE.defaultTitle} description={SITE.defaultDescription}>
  <Header />
  <main>
    <Hero />
    <Services />
    <ProjectsSlider />
    <SocialProjects />
    <AboutImpact />
    <Contact />
  </main>
  <Footer />
</Layout>
