---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="NeuralJira — De Agencia a SaaS: La Serie"
  description="NeuralJira documenta el viaje real de pasar de agencia de desarrollo a SaaS propio en Colombia. Guías, episodios y recursos para founders técnicos latinoamericanos."
>
  <!-- Esta página incorpora directamente la guía interactiva -->
  <!-- El contenido completo está en startup-colombia-guide.html -->
  <!-- Mientras migramos a componentes Astro, usamos un iframe optimizado -->
  <style>
    .guia-wrapper {
      width: 100%;
      min-height: 100vh;
    }

    /* Breadcrumb de regreso al sitio principal */
    .guia-bar {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 200;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: .6rem 1.5rem;
      background: rgba(11,15,26,0.95);
      border-bottom: 1px solid rgba(37,46,66,.8);
      backdrop-filter: blur(12px);
      font-family: 'JetBrains Mono', monospace;
      font-size: .72rem;
      color: #4A5568;
    }
    .guia-bar a {
      color: #F97316;
      text-decoration: none;
      letter-spacing: .05em;
    }
    .guia-bar a:hover { text-decoration: underline; }
    .guia-bar .sep { color: #252E42; }
  </style>

  <div class="guia-bar">
    <a href="/">← neuraljira.tech</a>
    <span class="sep">/</span>
    <span>guia · de-agencia-a-saas</span>
  </div>

  <div class="guia-wrapper" style="padding-top: 2.2rem;">
    <!-- 
      TODO Fase 1: Migrar el HTML a componentes Astro individuales:
      - <GuiaHero /> — sección hero con terminal
      - <GuiaEpisodios /> — grid de episodios expandibles
      - <GuiaIdeaComercial /> — GymTrack SaaS idea
      - <GuiaRegulacion /> — info legal Colombia
      - <GuiaHerramientas /> — tabla de stack
      
      Por ahora se enlaza directamente al archivo HTML
      que vive en la raíz del proyecto (public/).
    -->
    <script>
      // Redirigir al HTML directamente hasta la migración a componentes
      // El archivo startup-colombia-guide.html debe moverse a /public/
      window.location.replace('/startup-colombia-guide.html');
    </script>
    <noscript>
      <p style="font-family: sans-serif; text-align:center; padding: 4rem; color: #CBD5E1;">
        <a href="/startup-colombia-guide.html" style="color: #F97316;">Ver la guía →</a>
      </p>
    </noscript>
  </div>
</Layout>
