---
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import { SITE } from '../config/site';

const navLinks = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#proyectos', label: 'Proyectos' },
  { href: '/#impacto-social', label: 'Impacto Social' },
  { href: '/#nosotros', label: 'Nosotros' },
  { href: '/#contacto', label: 'Contacto' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand-link" aria-label={`${SITE.name} — Inicio`}>
      <BrandMark size={30} />
      <span class="brand-wordmark">
        Neural<strong>JIRA</strong>
      </span>
    </a>

    <nav class="primary-nav" aria-label="Principal">
      <ul class="primary-nav__list" role="list">
        {navLinks.map((item) => (
          <li>
            <a href={item.href} class="primary-nav__link">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <!-- Clean two-state Moon / Sun color-scheme toggle (pure CSS state sync) -->
      <button type="button" class="icon-btn scheme-toggle" data-scheme-toggle>
        <span class="scheme-option scheme-option--to-dark">
          <Icon name="moon" size={18} />
          <span class="visually-hidden">Cambiar a modo oscuro</span>
        </span>
        <span class="scheme-option scheme-option--to-light">
          <Icon name="sun" size={18} />
          <span class="visually-hidden">Cambiar a modo claro</span>
        </span>
      </button>

      <a href="/#contacto" class="btn btn-primary btn-sm header-cta">
        Cotizar proyecto
      </a>

      <button
        type="button"
        class="icon-btn mobile-menu-btn"
        id="mobile-menu-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <Icon name="menu" size={20} class="icon-open" />
        <Icon name="x" size={20} class="icon-close" />
      </button>
    </div>
  </div>

  <!-- Accessible Mobile Navigation Drawer -->
  <div id="mobile-nav-drawer" class="mobile-drawer" hidden>
    <nav class="container mobile-drawer__nav" aria-label="Navegación móvil">
      <ul role="list" class="mobile-drawer__list">
        {navLinks.map((item) => (
          <li>
            <a href={item.href} class="mobile-drawer__link">{item.label}</a>
          </li>
        ))}
      </ul>
      <a href="/#contacto" class="btn btn-primary mobile-drawer__cta">
        Solicitar cotización
        <Icon name="arrow-right" size={16} />
      </a>
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');

  function setMenuOpen(open: boolean) {
    if (!menuBtn || !drawer) return;
    drawer.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
    menuBtn.classList.toggle('is-open', open);
  }

  menuBtn?.addEventListener('click', () => {
    const isOpen = menuBtn.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!isOpen);
  });

  drawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.hidden) {
      setMenuOpen(false);
      menuBtn?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-block-end: 1px solid var(--border-subtle);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-block-size: var(--header-height);
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text-primary);
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-wordmark {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .brand-wordmark strong {
    font-weight: 700;
  }

  .primary-nav__list {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .primary-nav__link {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.35rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 150ms ease, background-color 150ms ease;
  }

  .primary-nav__link:hover {
    color: var(--text-primary);
    background: var(--surface-subtle);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2.45rem;
    min-block-size: 2.45rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    background: var(--surface-elevated);
    color: var(--text-secondary);
    transition: border-color 150ms ease, color 150ms ease, background-color 150ms ease;
  }

  .icon-btn:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  /* Pure CSS state visibility for Moon / Sun button (stays in sync without JS) */
  .scheme-option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .scheme-option--to-light {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not(:has(> head > meta[name="color-scheme"][content="light"]))) .scheme-option--to-dark {
      display: none;
    }
    :global(:root:not(:has(> head > meta[name="color-scheme"][content="light"]))) .scheme-option--to-light {
      display: inline-flex;
    }
  }

  :global(:root:has(> head > meta[name="color-scheme"][content="dark"])) .scheme-option--to-dark {
    display: none;
  }
  :global(:root:has(> head > meta[name="color-scheme"][content="dark"])) .scheme-option--to-light {
    display: inline-flex;
  }

  /* Mobile Menu */
  .mobile-menu-btn {
    display: none;
  }

  .mobile-menu-btn :global(.icon-close) {
    display: none;
  }
  .mobile-menu-btn.is-open :global(.icon-open) {
    display: none;
  }
  .mobile-menu-btn.is-open :global(.icon-close) {
    display: inline-block;
  }

  .mobile-drawer {
    background: var(--surface-elevated);
    border-block-end: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-md);
  }

  .mobile-drawer[hidden] {
    display: none;
  }

  .mobile-drawer__nav {
    padding-block: 1rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-drawer__list {
    display: flex;
    flex-direction: column;
  }

  .mobile-drawer__link {
    display: flex;
    align-items: center;
    min-block-size: 3rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    border-block-end: 1px solid var(--border-subtle);
  }

  .mobile-drawer__cta {
    inline-size: 100%;
  }

  @media (max-width: 820px) {
    .primary-nav,
    .header-cta {
      display: none;
    }

    .mobile-menu-btn {
      display: inline-flex;
    }
  }
</style>
