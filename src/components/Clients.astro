---
const clients = [
    { name: "Reto Fitness", logo: "/icoretofitnes.ico", url: "https://retocarlenis.neuraljira.tech/" },
    { name: "Cactunet", logo: "/cactunet.ico", url: "https://cactusnet.com.co/" }
];
---

<section class="clients-section">
    <div class="container">
        <p class="clients-title">Empresas que confían en nosotros</p>
        <div class="marquee-wrapper">
            <div class="marquee-content">
                {
                    clients.map((client) => (
                        <a href={client.url} target="_blank" rel="noopener noreferrer" class="client-item" title={client.name}>
                            <img src={client.logo} alt={`Logo de ${client.name}`} />
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .clients-section {
        padding: var(--spacing-lg) 0;
        border-bottom: 1px solid var(--border-color);
        background: var(--color-bg);
        overflow: hidden;
    }

    .clients-title {
        text-align: center;
        font-size: 0.9rem;
        color: var(--color-text-muted);
        margin-bottom: var(--spacing-lg);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .marquee-wrapper {
        position: relative;
        width: 100%;
        overflow: hidden;
    }

    .marquee-content {
        display: flex;
        gap: 4rem;
        width: 100%;
        justify-content: center;
        flex-wrap: wrap;
    }

    .client-item {
        opacity: 0.6;
        transition: opacity 0.3s ease, transform 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .client-item img {
        height: 50px;
        width: auto;
        object-fit: contain;
        filter: grayscale(100%);
        transition: filter 0.3s ease;
    }

    .client-item:hover {
        opacity: 1;
        transform: scale(1.05);
    }

    .client-item:hover img {
        filter: grayscale(0%);
    }
</style>
