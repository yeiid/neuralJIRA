---
// Services.astro — Servicios Profesionales de Ingeniería y Desarrollo
const WHATSAPP = "573058079573";
const wa = (msg: string) =>
  `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;

const services = [
  {
    id: "web-seo",
    icon: "🌐",
    title: "Desarrollo Web & Portales de Alto Rendimiento",
    subtitle: "Astro 5 · TypeScript · Next.js · Tailwind",
    description:
      "Construimos sitios web y portales ultra veloces, diseñados específicamente para posicionar en Google (SEO), cargar en menos de 1 segundo y convertir visitantes en clientes reales por WhatsApp o formulario.",
    badge: "Velocidad & Conversión",
    deliverables: [
      "Core Web Vitals < 1s (Puntuación 95+ en Google PageSpeed)",
      "SEO técnico, microdatos Schema.org y posicionamiento local",
      "Arquitectura multi-idioma (i18n) con soporte en lenguas nativas",
      "Diseño responsive optimizado para smartphones y conexiones 4G/rurales",
      "Entrega del código fuente 100% propio y sin dependencias obsoletas"
    ],
    metric: "LCP < 1.0s · 0 dependencias lentas",
    cta: "Cotizar Desarrollo Web"
  },
  {
    id: "bots-ia",
    icon: "🤖",
    title: "Automatización & Bots de WhatsApp con IA",
    subtitle: "WhatsApp Cloud API · LLMs · n8n · CRM",
    description:
      "Transformamos canales de mensajería en máquinas de ventas y atención automatizada 24/7. Agentes inteligentes entrenados con tu catálogo que atienden consultas, cotizan y agendan sin esperas.",
    badge: "Atención 24/7 sin Demoras",
    deliverables: [
      "Respuestas inmediatas en lenguaje natural a preguntas frecuentes",
      "Calificación automática de leads y sincronización directa con CRM",
      "Envío instantáneo de cotizaciones, catálogos y enlaces de pago",
      "Derivación fluida a asesores humanos cuando se requiere cierre",
      "Cumplimiento formal de la Ley 1581 (Habeas Data Colombia)"
    ],
    metric: "0s tiempo de espera · Atención continua",
    cta: "Cotizar Bot de WhatsApp"
  },
  {
    id: "software-medida",
    icon: "⚡",
    title: "Software a la Medida & Sistemas Local-First",
    subtitle: "FastAPI · Go 1.24 · PostgreSQL · node:sqlite WAL",
    description:
      "Desarrollamos sistemas de gestión operativa (POS para restaurantes, inventarios con gemelos digitales 3D y control de despachos) con arquitectura tolerante a fallos que sigue funcionando aun si se cae internet.",
    badge: "Cero Caídas de Operación",
    deliverables: [
      "Operación continua en red local LAN (100% offline-first)",
      "Bases de datos transaccionales ultra seguras (WAL mode)",
      "Gemelos digitales y visualizaciones interactivas 3D con Three.js",
      "Ejecutables nativos de doble clic para Windows y servidores Linux",
      "Soporte y acompañamiento técnico directo en el punto de venta"
    ],
    metric: "Disponibilidad 99.9% · Tolerante a cortes de red",
    cta: "Cotizar Software a Medida"
  },
  {
    id: "consultoria",
    icon: "📐",
    title: "Arquitectura de Sistemas & Consultoría Técnica",
    subtitle: "Auditoría de Código · Microservicios · Cloud & Edge",
    description:
      "Evaluamos y optimizamos plataformas existentes para eliminar lentitud, cuellos de botella en bases de datos o vulnerabilidades. Diseñamos la infraestructura tecnológica para escalar tu negocio con seguridad.",
    badge: "Ingeniería Formal",
    deliverables: [
      "Diagnóstico técnico profundo de rendimiento y seguridad",
      "Migración de plataformas obsoletas (WordPress/Wix) a stacks modernos",
      "Diseño y documentación de APIs RESTful según estándar OpenAPI",
      "Contratos de confidencialidad (NDA), propiedad intelectual y SLA",
      "Facturación electrónica formal DIAN y soporte post-entrega"
    ],
    metric: "Soporte garantizado · Facturación electrónica",
    cta: "Solicitar Diagnóstico"
  }
];
---

<section id="servicios" class="section services">
  <div class="container">
    <div class="section-header">
      <div class="badge-wrapper">
        <span class="badge">// INGENIERÍA & SOLUCIONES DIGITALES</span>
      </div>
      <h2 class="section-title">
        Servicios Diseñados para <span class="text-gradient">Negocios Reales</span>
      </h2>
      <p class="section-subtitle">
        Desarrollamos soluciones tecnológicas con arquitectura escalable, código limpio y entregables tangibles por contrato. Sin plantillas genéricas ni cajas negras.
      </p>
    </div>

    <div class="services-grid">
      {
        services.map((service) => (
          <article class="service-card">
            <header class="service-card-header">
              <div class="icon-and-badge">
                <span class="service-icon">{service.icon}</span>
                <span class="service-chip">{service.badge}</span>
              </div>
              <h3 class="service-title">{service.title}</h3>
              <p class="service-subtitle">{service.subtitle}</p>
            </header>

            <p class="service-description">{service.description}</p>

            <div class="service-deliverables">
              <h4 class="deliverables-heading">Qué incluye el servicio:</h4>
              <ul class="deliverables-list">
                {service.deliverables.map((item) => (
                  <li>
                    <span class="check-icon">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <footer class="service-card-footer">
              <div class="service-metric">
                <span class="metric-dot"></span>
                <span class="metric-text">{service.metric}</span>
              </div>
              <a
                href={wa(`Hola NeuralJira, me gustaría cotizar el servicio: ${service.title}.`)}
                target="_blank"
                rel="noopener noreferrer"
                class="service-cta-btn"
              >
                {service.cta} <span>→</span>
              </a>
            </footer>
          </article>
        ))
      }
    </div>

    <!-- Banner de Confianza y Calidad -->
    <div class="services-trust-banner">
      <div class="trust-item">
        <span class="trust-icon">🛡️</span>
        <div>
          <strong>Garantía de 30 Días</strong>
          <p>Soporte técnico y ajustes posteriores al lanzamiento incluidos sin costo adicional.</p>
        </div>
      </div>
      <div class="trust-item">
        <span class="trust-icon">📜</span>
        <div>
          <strong>Propiedad Intelectual Total</strong>
          <p>El código, accesos y dominio quedan 100% a nombre de tu empresa.</p>
        </div>
      </div>
      <div class="trust-item">
        <span class="trust-icon">🧾</span>
        <div>
          <strong>Formalidad y Facturación</strong>
          <p>Contrato de prestación de servicios y facturación electrónica DIAN.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--ink);
    padding: var(--spacing-xl) 0;
    position: relative;
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  .badge-wrapper {
    margin-bottom: var(--spacing-sm);
  }

  .badge {
    display: inline-block;
    padding: 0.35rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent);
    background: rgba(249, 115, 22, 0.1);
    border: 1px solid rgba(249, 115, 22, 0.3);
    border-radius: 9999px;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.85rem);
    line-height: 1.2;
    margin-bottom: var(--spacing-sm);
    color: var(--white);
  }

  .text-gradient {
    background: linear-gradient(135deg, var(--accent) 0%, var(--electric) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-subtitle {
    max-width: 720px;
    margin: 0 auto;
    font-size: 1.05rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .service-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s, box-shadow 0.3s;
    position: relative;
    overflow: hidden;
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--electric));
    opacity: 0;
    transition: opacity 0.3s;
  }

  .service-card:hover {
    transform: translateY(-5px);
    border-color: rgba(249, 115, 22, 0.5);
    box-shadow: 0 16px 36px -12px rgba(0, 0, 0, 0.5);
  }

  .service-card:hover::before {
    opacity: 1;
  }

  .service-card-header {
    margin-bottom: 1.25rem;
  }

  .icon-and-badge {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .service-icon {
    font-size: 2.2rem;
  }

  .service-chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.25rem 0.65rem;
    background: rgba(56, 189, 248, 0.1);
    color: var(--electric);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 999px;
    font-weight: 600;
  }

  .service-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 0.35rem;
    line-height: 1.3;
  }

  .service-subtitle {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    margin-bottom: 0;
  }

  .service-description {
    color: var(--text);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .service-deliverables {
    background: rgba(11, 15, 26, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin-bottom: 1.75rem;
    flex-grow: 1;
  }

  .deliverables-heading {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--light);
    margin-bottom: 0.75rem;
  }

  .deliverables-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .deliverables-list li {
    font-size: 0.85rem;
    color: var(--text);
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    line-height: 1.45;
  }

  .check-icon {
    color: var(--green);
    font-weight: 700;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .service-card-footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .service-metric {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .metric-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px var(--green);
  }

  .metric-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .service-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: transparent;
    color: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none;
    transition: all 0.25s;
  }

  .service-cta-btn:hover {
    background: var(--accent);
    color: var(--ink);
    border-color: var(--accent);
  }

  .service-cta-btn span {
    transition: transform 0.2s;
  }

  .service-cta-btn:hover span {
    transform: translateX(4px);
  }

  /* Trust Banner */
  .services-trust-banner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }

  .trust-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .trust-icon {
    font-size: 1.8rem;
    flex-shrink: 0;
  }

  .trust-item strong {
    display: block;
    color: var(--white);
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }

  .trust-item p {
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.45;
    margin: 0;
  }
</style>
