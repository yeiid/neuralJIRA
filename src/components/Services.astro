---
import Icon from './Icon.astro';
import type { IconName } from '../config/icons';
import WhatsAppBotDemo from './demos/WhatsAppBotDemo.astro';
import { waUrl } from '../config/site';

interface ServiceItem {
  id: string;
  icon: IconName;
  title: string;
  subtitle: string;
  summary: string;
  deliverables: string[];
  demoAction?: {
    label: string;
    sandboxTitle: string;
    sandboxUrl: string;
  };
  anchorAction?: {
    label: string;
    href: string;
  };
  cta: string;
}

const services: ServiceItem[] = [
  {
    id: 'landing-web',
    icon: 'globe',
    title: 'Landing Pages & Sitios Web',
    subtitle: 'Alta conversión · SEO técnico · Mobile-first',
    summary:
      'Construimos páginas comerciales y portales corporativos ultrarrápidos, diseñados para posicionar en Google y convertir visitas en conversaciones de venta.',
    deliverables: [
      'Carga veloz incluso en redes móviles 4G y zonas rurales',
      'SEO técnico, Schema.org y configuración de Google Business',
      'Soporte multi-idioma y captación directa por WhatsApp',
      'Código 100% propio sin plantillas pesadas',
    ],
    demoAction: {
      label: 'Demo: CactusNet',
      sandboxTitle: 'CactusNet — Landing Page Comercial',
      sandboxUrl: 'https://cactusnet.com.co',
    },
    cta: 'Cotizar sitio web',
  },
  {
    id: 'ecommerce',
    icon: 'box',
    title: 'Tiendas Online & Catálogos',
    subtitle: 'Comercio electrónico · Catálogo ágil · Móvil',
    summary:
      'Vitrinas digitales diseñadas para vender desde Instagram, WhatsApp y Google con exploración fluida de productos, carrito claro y pasarelas locales.',
    deliverables: [
      'Catálogo visual ligero optimizado para compradores en celular',
      'Estructura indexable lista para campañas y búsqueda orgánica',
      'Integración de stock, pedidos por WhatsApp o pago online',
      'Panel administrable y escalable a tu ritmo comercial',
    ],
    demoAction: {
      label: 'Demo: Jamuchee',
      sandboxTitle: 'Jamuchee — Tienda Online',
      sandboxUrl: 'https://jamuchee.vercel.app/',
    },
    cta: 'Cotizar tienda online',
  },
  {
    id: 'bots-ia',
    icon: 'message-square',
    title: 'Bots de WhatsApp con IA',
    subtitle: 'WhatsApp Cloud API · Calificación 24/7 · CRM',
    summary:
      'Asistentes entrenados con tu catálogo que responden en menos de un segundo, resuelven dudas frecuentes, califican leads y derivan cierres a tu equipo.',
    deliverables: [
      'Atención continua 24/7 con respuestas naturales y precisas',
      'Registro automático de clientes potenciales en tu CRM',
      'Envío inmediato de catálogos y agendamiento de citas',
      'Cumplimiento formal de la Ley 1581 (Habeas Data Colombia)',
    ],
    anchorAction: {
      label: 'Probar simulador abajo',
      href: '#simulador-whatsapp',
    },
    cta: 'Cotizar bot con IA',
  },
  {
    id: 'software-medida',
    icon: 'cpu',
    title: 'Software a Medida & Local-First',
    subtitle: 'POS · Inventarios 3D · Operación sin internet',
    summary:
      'Sistemas operativos diseñados a la medida de tu negocio (restaurantes, bodegas, gimnasios) que siguen funcionando en red local aunque caiga internet.',
    deliverables: [
      'Arquitectura Local-First tolerante a cortes de conectividad',
      'Gemelos digitales 3D, pantallas de cocina KDS y comandas QR',
      'Ejecutables nativos para Windows y servidores Linux',
      'Acompañamiento técnico y puesta en marcha en punto de venta',
    ],
    anchorAction: {
      label: 'Ver demos en slider',
      href: '#proyectos',
    },
    cta: 'Cotizar software a medida',
  },
];
---

<section id="servicios" class="section section--tinted services-section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Qué Vendemos</p>
      <h2>Servicios digitales enfocados en ventas y operación real.</h2>
      <p class="section-lead">
        Cada proyecto se cotiza a la medida de tus objetivos, con entregables claros por contrato,
        propiedad intelectual 100% para tu empresa y demos verificables.
      </p>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <article class="surface-card surface-card--interactive service-card">
          <div class="service-card__top">
            <span class="service-card__icon" aria-hidden="true">
              <Icon name={service.icon} size={20} />
            </span>

            {service.demoAction ? (
              <button
                type="button"
                class="service-card__demo-btn font-mono"
                data-open-sandbox
                data-sandbox-title={service.demoAction.sandboxTitle}
                data-sandbox-url={service.demoAction.sandboxUrl}
                data-sandbox-service={service.title}
              >
                <Icon name="play" size={12} />
                <span>{service.demoAction.label}</span>
              </button>
            ) : service.anchorAction ? (
              <a href={service.anchorAction.href} class="service-card__demo-btn font-mono">
                <span>{service.anchorAction.label}</span>
                <Icon name="arrow-up-right" size={13} />
              </a>
            ) : null}
          </div>

          <h3 class="service-card__title">{service.title}</h3>
          <p class="service-card__stack font-mono">{service.subtitle}</p>
          <p class="service-card__summary">{service.summary}</p>

          <ul class="service-card__list" role="list">
            {service.deliverables.map((item) => (
              <li>
                <Icon name="check" size={15} class="service-card__check" />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="service-card__cta-row">
            <a
              href="#contacto"
              class="btn btn-secondary btn-sm"
              data-prefill-service={service.title}
              data-prefill-note={`Hola NeuralJIRA, me gustaría cotizar el servicio de ${service.title} para mi negocio.`}
            >
              <span>{service.cta}</span>
              <Icon name="arrow-right" size={14} />
            </a>
            <a
              href={waUrl(`Hola NeuralJIRA, quiero cotizar: ${service.title}.`)}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost btn-sm"
              aria-label={`Cotizar ${service.title} por WhatsApp`}
            >
              <Icon name="whatsapp" size={14} />
              <span>WhatsApp</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Interactive Proof for WhatsApp AI Automation -->
    <div id="simulador-whatsapp" class="bot-proof-block">
      <div class="bot-proof-block__copy">
        <p class="eyebrow">Demo Interactiva · Automatización IA</p>
        <h3>Prueba cómo atiende un bot comercial antes de cotizarlo.</h3>
        <p>
          Toca cualquiera de las consultas del simulador para comprobar el tiempo de respuesta,
          la calificación automática del cliente y el traspaso inmediato a tu equipo.
        </p>
        <ul class="bot-proof-block__bullets" role="list">
          <li><Icon name="check" size={15} class="service-card__check" /> <span>Entrenado con tus productos, servicios y políticas reales.</span></li>
          <li><Icon name="check" size={15} class="service-card__check" /> <span>Integración oficial con WhatsApp Cloud API.</span></li>
          <li><Icon name="check" size={15} class="service-card__check" /> <span>Derivación instantánea a un asesor humano cuando el cliente está listo.</span></li>
        </ul>
      </div>

      <WhatsAppBotDemo />
    </div>

    <!-- Commercial Guarantees -->
    <div class="guarantees-bar">
      <div class="guarantee-item">
        <span class="guarantee-item__icon"><Icon name="shield-check" size={20} /></span>
        <div>
          <strong>Garantía de 30 días</strong>
          <p>Soporte post-lanzamiento y ajustes incluidos sin costo adicional.</p>
        </div>
      </div>
      <div class="guarantee-item">
        <span class="guarantee-item__icon"><Icon name="file-text" size={20} /></span>
        <div>
          <strong>Propiedad intelectual total</strong>
          <p>Código fuente, dominio y accesos quedan 100% a nombre de tu empresa.</p>
        </div>
      </div>
      <div class="guarantee-item">
        <span class="guarantee-item__icon"><Icon name="receipt" size={20} /></span>
        <div>
          <strong>Contrato formal y DIAN</strong>
          <p>Cotización a medida por escrito y facturación electrónica legal en Colombia.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-block-end: 2.5rem;
  }

  .service-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .service-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block-end: 0.25rem;
  }

  .service-card__icon {
    inline-size: 2.65rem;
    block-size: 2.65rem;
    border-radius: var(--radius-md);
    background: var(--brand-accent-soft);
    color: var(--brand-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .service-card__demo-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--brand-secondary);
    padding: 0.32rem 0.65rem;
    min-block-size: 2rem;
    border-radius: var(--radius-sm);
    background: var(--brand-secondary-soft);
    border: 1px solid var(--brand-secondary-border);
    transition: border-color 150ms ease, background-color 150ms ease;
  }

  .service-card__demo-btn:hover {
    border-color: var(--brand-secondary);
    background: color-mix(in oklab, var(--brand-secondary) 18%, transparent);
  }

  .service-card__title {
    font-size: 1.25rem;
  }

  .service-card__stack {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .service-card__summary {
    font-size: 0.93rem;
    line-height: 1.6;
  }

  .service-card__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    border-radius: var(--radius-md);
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    flex: 1;
    margin-block: 0.35rem;
  }

  .service-card__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.86rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .service-card__check {
    color: var(--status-success);
    margin-block-start: 0.15rem;
  }

  .service-card__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding-block-start: 0.6rem;
    border-block-start: 1px solid var(--border-subtle);
  }

  .bot-proof-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 2rem;
    align-items: center;
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem);
    background: var(--surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    margin-block-end: 2rem;
  }

  .bot-proof-block__copy {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .bot-proof-block__copy h3 {
    font-size: var(--text-2xl);
  }

  .bot-proof-block__bullets {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-block-start: 0.25rem;
  }

  .bot-proof-block__bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .guarantees-bar {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    padding: 1.5rem 1.75rem;
    background: var(--surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .guarantee-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .guarantee-item__icon {
    inline-size: 2.35rem;
    block-size: 2.35rem;
    border-radius: var(--radius-md);
    background: var(--surface-subtle);
    color: var(--brand-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .guarantee-item strong {
    display: block;
    font-size: 0.94rem;
    color: var(--text-primary);
    margin-block-end: 0.2rem;
  }

  .guarantee-item p {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .services-grid,
    .bot-proof-block,
    .guarantees-bar {
      grid-template-columns: 1fr;
    }
  }
</style>
