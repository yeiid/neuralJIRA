---
const WHATSAPP = "573058079573";
const wa = (msg: string) =>
    `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;

const plans = [
    {
        name: "Arranque Digital",
        tag: "Para negocios sin web",
        price: "1.200.000",
        featured: false,
        features: [
            "Landing page rápida y adaptable a celular",
            "Botón de WhatsApp y formulario de contacto",
            "Perfil de Google Business configurado",
            "SEO básico + Google Analytics",
            "Entrega en 1 semana",
        ],
    },
    {
        name: "Negocio Visible",
        tag: "Web + SEO local · Más elegido",
        price: "4.200.000",
        featured: true,
        features: [
            "Sitio corporativo de 4 a 8 páginas",
            "SEO técnico y SEO local en Google Maps",
            "3 meses de SEO mensual incluidos",
            "Informe mensual de resultados",
            "Entrega en 2 a 3 semanas",
        ],
    },
    {
        name: "Negocio Automático",
        tag: "Web + Bot de WhatsApp",
        price: "6.500.000",
        featured: false,
        features: [
            "Sitio web profesional",
            "Bot de WhatsApp que responde 24/7",
            "Captura de clientes potenciales en CRM",
            "Integración con IA opcional",
            "Capacitación a tu equipo",
        ],
    },
];

const recurring = [
    { name: "SEO mensual", price: "600.000", unit: "/ mes" },
    { name: "Bot de WhatsApp (operación)", price: "200.000", unit: "/ mes" },
    { name: "Hosting y mantenimiento", price: "80.000", unit: "/ mes" },
    { name: "Software a la medida", price: "4.000.000", unit: "proyecto" },
];
---

<section id="precios" class="section pricing">
    <div class="container">
        <div class="section-header">
            <p class="section-label">// planes y precios</p>
            <h2 class="section-title">Precios claros, sin sorpresas</h2>
            <p class="section-subtitle">
                Valores de referencia en pesos colombianos. Cada proyecto se
                cotiza por escrito tras un diagnóstico técnico gratuito.
            </p>
        </div>

        <!-- Banner Modelo Piloto de Co-Desarrollo -->
        <div class="pilot-banner">
            <div class="pilot-badge-wrapper">
                <span class="pilot-badge">MODELO PILOTO 2026</span>
            </div>
            <p class="pilot-text">
                <strong class="pilot-title">Ventajas del Modelo Piloto de Co-Desarrollo:</strong>
                Como primer cliente de validación, el negocio recibe una solución personalizada construida según su flujo real de venta, con acompañamiento técnico directo, pruebas en el punto de venta y un descuento comercial sustancial frente a licencias corporativas genéricas.
            </p>
        </div>

        <div class="plans-grid">
            {
                plans.map((plan) => (
                    <article class:list={["plan", { featured: plan.featured }]}>
                        <p class="plan-tag">{plan.tag}</p>
                        <h3 class="plan-name">{plan.name}</h3>
                        <p class="plan-price">
                            <span class="from">desde</span>
                            <span class="amount">${plan.price}</span>
                            <span class="currency">COP</span>
                        </p>
                        <ul class="plan-features">
                            {plan.features.map((f) => (
                                <li>{f}</li>
                            ))}
                        </ul>
                        <a
                            href={wa(
                                `Hola NeuralJira, me interesa el paquete ${plan.name}. ¿Podemos hablar?`,
                            )}
                            target="_blank"
                            rel="noopener noreferrer"
                            class={plan.featured ? "btn-primary" : "btn-ghost"}
                        >
                            Quiero este plan
                        </a>
                    </article>
                ))
            }
        </div>

        <div class="recurring">
            <h3>Servicios individuales</h3>
            <ul>
                {
                    recurring.map((r) => (
                        <li>
                            <span>{r.name}</span>
                            <span class="r-price">
                                desde ${r.price} <small>{r.unit}</small>
                            </span>
                        </li>
                    ))
                }
            </ul>
            <p class="note">
                Forma de pago: 50 % de anticipo y 50 % contra entrega. Precios
                antes de impuestos aplicables.
            </p>
        </div>
    </div>
</section>

<style>
    .pricing {
        background: var(--deep);
    }

    .section-header {
        text-align: center;
        margin-bottom: var(--spacing-xl);
    }

    .section-subtitle {
        color: var(--text);
        max-width: 600px;
        margin: var(--spacing-sm) auto 0;
    }

    /* Banner Piloto de Co-Desarrollo */
    .pilot-banner {
        background: rgba(249, 115, 22, 0.08);
        border: 1px solid rgba(249, 115, 22, 0.35);
        border-left: 5px solid var(--accent);
        border-radius: var(--radius-md);
        padding: 1.25rem 1.5rem;
        margin-bottom: var(--spacing-xl);
        box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.4);
    }

    .pilot-badge-wrapper {
        margin-bottom: 0.5rem;
    }

    .pilot-badge {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: var(--accent);
        background: rgba(249, 115, 22, 0.15);
        padding: 0.2rem 0.55rem;
        border-radius: 4px;
        border: 1px solid rgba(249, 115, 22, 0.3);
    }

    .pilot-text {
        color: var(--light);
        font-size: 0.95rem;
        line-height: 1.6;
        margin: 0;
    }

    .pilot-title {
        color: var(--white);
        font-weight: 700;
    }

    .plans-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
        gap: var(--spacing-lg);
        align-items: stretch;
    }

    .plan {
        display: flex;
        flex-direction: column;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: var(--spacing-lg);
        transition:
            transform 0.3s,
            border-color 0.3s;
    }

    .plan:hover {
        transform: translateY(-4px);
        border-color: var(--accent);
    }

    .plan.featured {
        border-color: var(--accent);
        box-shadow: 0 0 0 1px var(--accent), 0 20px 40px -20px rgba(249, 115, 22, 0.4);
    }

    .plan-tag {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--electric);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .plan-name {
        margin: 0.4rem 0 1rem;
    }

    .plan-price {
        display: flex;
        align-items: baseline;
        gap: 0.4rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
        color: var(--white);
    }

    .from,
    .currency {
        font-size: 0.85rem;
        color: var(--text);
    }

    .amount {
        font-size: 2rem;
        font-weight: 700;
    }

    .plan-features {
        list-style: none;
        flex-grow: 1;
        margin-bottom: 1.5rem;
    }

    .plan-features li {
        color: var(--text);
        padding: 0.35rem 0 0.35rem 1.5rem;
        position: relative;
        font-size: 0.95rem;
    }

    .plan-features li::before {
        content: "✓";
        position: absolute;
        left: 0;
        color: var(--green);
        font-weight: 700;
    }

    .recurring {
        margin-top: var(--spacing-xl);
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: var(--spacing-lg);
    }

    .recurring h3 {
        margin-bottom: 1rem;
    }

    .recurring ul {
        list-style: none;
    }

    .recurring li {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--border);
        color: var(--text);
    }

    .r-price {
        color: var(--white);
        font-weight: 600;
        white-space: nowrap;
    }

    .r-price small {
        color: var(--text);
        font-weight: 400;
    }

    .note {
        margin-top: 1rem;
        font-size: 0.85rem;
        color: var(--text);
    }
</style>
