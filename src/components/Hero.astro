<section id="inicio" class="hero">
    <div class="container hero-content">
        <h1 class="title">
            Impulsa tu Negocio con <br />
            <span class="text-gradient">Tecnología a Medida</span>
        </h1>
        <p class="subtitle">
            Ofrecemos asesoría experta y desarrollo de software personalizado
            para ayudarte a escalar tu negocio de manera eficiente y robusta.
        </p>
        <div class="cta-group">
            <a href="#contacto" class="btn btn-primary">Empezar ahora</a>
            <a href="#servicios" class="btn btn-secondary">Ver servicios</a>
        </div>
    </div>

    <div class="hero-bg"></div>
</section>

<style>
    .hero {
        position: relative;
        padding: 180px 0 100px;
        overflow: hidden;
        text-align: center;
        min-height: 100vh;
        display: grid;
        place-items: center;
    }

    .hero::before {
        content: '';
        position: absolute; inset: 0;
        background:
            radial-gradient(ellipse 60% 50% at 70% 40%, rgba(249,115,22,.08) 0%, transparent 70%),
            radial-gradient(ellipse 40% 60% at 20% 70%, rgba(56,189,248,.06) 0%, transparent 60%);
        pointer-events: none;
    }

    .hero-content {
        position: relative;
        z-index: 1;
        max-width: 800px;
    }

    .title {
        margin-bottom: var(--spacing-lg);
    }

    .subtitle {
        font-size: 1.15rem;
        color: var(--muted);
        margin-bottom: var(--spacing-xl);
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
        line-height: 1.65;
    }

    .cta-group {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }
</style>

