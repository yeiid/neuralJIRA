---
import { Image } from 'astro:assets';
import cactusnetImg from '../assets/products/cactusnet.png';
import Icon from './Icon.astro';
---

<section id="inicio" class="hero">
  <div class="hero__wash" aria-hidden="true"></div>

  <div class="container hero__grid">
    <!-- Left Column: Direct Commercial Value Proposition -->
    <div class="hero__content">
      <p class="eyebrow">Estudio de Ingeniería de Software · Colombia</p>

      <h1 id="contenido-principal" tabindex="-1" class="hero__title">
        Software comercial y automatización que
        <span class="hero__accent">ponen a vender tu negocio.</span>
      </h1>

      <p class="hero__lead">
        Diseñamos landing pages de alta conversión, tiendas online, bots de WhatsApp con IA y
        sistemas <strong>Local-First</strong> que trabajan incluso sin internet. Código 100% propio
        y entregas por contrato.
      </p>

      <div class="hero__actions">
        <a href="#proyectos" class="btn btn-primary">
          <span>Ver proyectos y demos</span>
          <Icon name="arrow-right" size={16} />
        </a>
        <a href="#contacto" class="btn btn-secondary">
          <span>Solicitar cotización</span>
        </a>
      </div>

      <dl class="hero__pillars">
        <div class="hero__pillar">
          <dt>Entrega formal</dt>
          <dd>Garantía de 30 días</dd>
        </div>
        <div class="hero__pillar">
          <dt>Propiedad total</dt>
          <dd>Código 100% tuyo</dd>
        </div>
        <div class="hero__pillar">
          <dt>Respaldo legal</dt>
          <dd>Facturación DIAN</dd>
        </div>
      </dl>
    </div>

    <!-- Right Column: Single Stable Showcase Frame (No Jarring Height Jumps) -->
    <div class="hero__showcase">
      <div class="showcase-card">
        <div class="browser-chrome">
          <span class="browser-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="browser-url font-mono">cactusnet.com.co</span>
          <span class="pill pill--success">Landing en producción</span>
        </div>

        <div class="showcase-media">
          <Image
            src={cactusnetImg}
            alt="Captura real de la landing page comercial de CactusNet en producción"
            widths={[640, 960, 1280]}
            sizes="(max-width: 960px) 92vw, 560px"
            format="webp"
            quality={84}
            fetchpriority="high"
            loading="eager"
            class="showcase-img"
          />
        </div>

        <div class="showcase-caption">
          <div>
            <strong>Ejemplo real: Landing Page comercial CactusNet</strong>
            <p>Carga veloz en móvil, 3 idiomas y captación directa por WhatsApp.</p>
          </div>
          <button
            type="button"
            class="btn btn-secondary btn-sm"
            data-open-sandbox
            data-sandbox-title="CactusNet — Landing Page Comercial"
            data-sandbox-url="https://cactusnet.com.co"
            data-sandbox-service="Landing Pages & Sitios Web"
          >
            <span>Probar demo</span>
            <Icon name="external-link" size={14} />
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 2.2rem + 2.8vw, 5rem) clamp(3.5rem, 2.5rem + 2.8vw, 5.25rem);
    overflow: clip;
  }

  .hero__wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(50% 62% at 10% 4%, var(--ambient-wash-1) 0%, transparent 70%),
      radial-gradient(46% 58% at 92% 96%, var(--ambient-wash-2) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 1.5rem + 2.5vw, 4rem);
    align-items: center;
  }

  .hero__title {
    margin-block-end: 1.25rem;
  }

  .hero__accent {
    color: var(--brand-accent);
  }

  .hero__lead {
    font-size: clamp(1rem, 0.96rem + 0.25vw, 1.125rem);
    line-height: 1.68;
    color: var(--text-secondary);
    max-inline-size: 56ch;
    margin-block-end: 1.85rem;
  }

  .hero__lead strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-block-end: 2.25rem;
  }

  .hero__pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--border-subtle);
    margin: 0;
  }

  .hero__pillar dt {
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-block-end: 0.2rem;
  }

  .hero__pillar dd {
    font-size: 0.94rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  /* Stable Fixed-Aspect Showcase Card */
  .showcase-card {
    background: var(--surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .browser-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    border-block-end: 1px solid var(--border-subtle);
    background: var(--surface-subtle);
  }

  .browser-dots {
    display: inline-flex;
    gap: 5px;
  }

  .browser-dots i {
    inline-size: 8px;
    block-size: 8px;
    border-radius: 50%;
    background: var(--border-strong);
    display: block;
  }

  .browser-url {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .showcase-media {
    aspect-ratio: 16 / 10;
    background: var(--surface-inset);
    overflow: hidden;
  }

  .showcase-img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .showcase-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 1rem 1.15rem;
    border-block-start: 1px solid var(--border-subtle);
    background: var(--surface-elevated);
  }

  .showcase-caption > div {
    flex: 1 1 13rem;
  }

  .showcase-caption strong {
    display: block;
    font-size: 0.88rem;
    color: var(--text-primary);
  }

  .showcase-caption p {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-block-start: 0.15rem;
  }

  @media (max-width: 980px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__pillars {
      max-inline-size: 36rem;
    }
  }

  @media (max-width: 520px) {
    .hero__pillars {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
