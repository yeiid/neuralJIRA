---
// Hero.astro — Inicio Dinámico & Futurista inspirado en Interfaces High-Tech / FinTech
---

<section id="inicio" class="hero" aria-label="Sección de Inicio">
  <!-- Dynamic Atmospheric Background -->
  <div class="hero-atmosphere" aria-hidden="true">
    <!-- Top Radial Spotlight Beam -->
    <div class="spotlight-beam"></div>
    <div class="spotlight-glow-secondary"></div>
    
    <!-- Cybernetic Perspective Grid -->
    <div class="grid-perspective"></div>

    <!-- Interactive Canvas for Constellation Particles -->
    <canvas id="hero-particle-canvas" class="particle-canvas"></canvas>

    <!-- Floating Technical & Mathematical Glyphs (inspired by reference UI) -->
    <div class="floating-glyphs">
      <span class="glyph glyph-1" style="--d: 0s; --x: 12%; --y: 22%;">λx.f(x)</span>
      <span class="glyph glyph-2" style="--d: 2.5s; --x: 82%; --y: 18%;">O(1)</span>
      <span class="glyph glyph-3" style="--d: 1.2s; --x: 8%; --y: 65%;">Ed25519</span>
      <span class="glyph glyph-4" style="--d: 3.8s; --x: 88%; --y: 60%;">0x7FF_A2</span>
      <span class="glyph glyph-5" style="--d: 1.8s; --x: 20%; --y: 80%;">sync_lan::v1</span>
      <span class="glyph glyph-6" style="--d: 4.2s; --x: 78%; --y: 78%;">∇L(θ)</span>
      <span class="glyph glyph-7" style="--d: 0.8s; --x: 5%; --y: 42%;">B.A.T.M.A.N.</span>
      <span class="glyph glyph-8" style="--d: 3.1s; --x: 92%; --y: 38%;">LLM.int8</span>
    </div>
  </div>

  <!-- Hero Content Center -->
  <div class="container hero-container">
    
    <!-- Top Live Status Pill -->
    <div class="trust-pill-wrapper">
      <a href="#ecosistema" class="trust-pill">
        <span class="pulse-indicator">
          <span class="pulse-ring"></span>
          <span class="pulse-dot"></span>
        </span>
        <span class="trust-text">Startup Estudio &amp; AI Lab</span>
        <span class="trust-divider">/</span>
        <span class="trust-highlight">Ecosistema 2026</span>
        <svg class="trust-arrow" viewBox="0 0 16 16" fill="currentColor">
          <path fill-rule="evenodd" d="M6.22 3.22a.75.75 0 011.06 0l4.25 4.25a.75.75 0 010 1.06l-4.25 4.25a.75.75 0 01-1.06-1.06L9.94 8 6.22 4.28a.75.75 0 010-1.06z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>

    <!-- Main Title with Glowing Typography -->
    <h1 class="hero-title">
      <span class="title-lead">Impulsa tu Negocio con</span>
      <span class="title-glow-wrap">
        <span class="title-glow-text">Tecnología de Alto Impacto</span>
        <span class="title-glow-backdrop" aria-hidden="true"></span>
      </span>
    </h1>

    <!-- Subtitle / Mission Statement -->
    <p class="hero-subtitle">
      Arquitectura de software a medida, productos SaaS escalables e infraestructura descentralizada. 
      Combinamos ingeniería avanzada con impacto real en el territorio.
    </p>

    <!-- Value Proposition Feature Pills (Under Title Row) -->
    <div class="features-pills-row" aria-label="Capacidades destacadas">
      <div class="feature-chip">
        <span class="chip-icon">🚀</span>
        <span class="chip-label">SaaS Escalables B2B</span>
      </div>
      <div class="feature-chip">
        <span class="chip-icon">🛡️</span>
        <span class="chip-label">Criptografía &amp; Offline-First</span>
      </div>
      <div class="feature-chip">
        <span class="chip-icon">🤖</span>
        <span class="chip-label">Edge AI Distribuido</span>
      </div>
      <div class="feature-chip">
        <span class="chip-icon">📡</span>
        <span class="chip-label">WiFi Mesh Comunitario</span>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="cta-actions">
      <a href="#ecosistema" class="btn-action-primary">
        <span class="btn-text">Explorar Ecosistema</span>
        <span class="btn-icon-circle">
          <svg viewBox="0 0 20 20" fill="currentColor" class="btn-arrow-svg">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </span>
      </a>

      <a href="#contacto" class="btn-action-secondary">
        <span>Iniciar Proyecto</span>
      </a>
    </div>

  </div>

  <!-- Bottom Interactive HUD / Bar -->
  <div class="hero-bottom-hud" aria-hidden="true">
    <div class="hud-item hud-left">
      <span class="hud-dot"></span>
      <span class="hud-label">Enfoque:</span>
      <span class="hud-value">Soberanía Tecnológica · ZOMAC Colombia</span>
    </div>

    <div class="hud-item hud-center">
      <span class="tech-badge">Go 1.24</span>
      <span class="tech-badge">Rust</span>
      <span class="tech-badge">OpenWrt</span>
      <span class="tech-badge">Headscale</span>
      <span class="tech-badge">Svelte</span>
      <span class="tech-badge">Astro</span>
    </div>

    <div class="hud-item hud-right">
      <a href="#quienes-somos" class="scroll-explore-btn" aria-label="Desplazar hacia abajo">
        <span>Scroll to explore</span>
        <svg class="scroll-arrow" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 3a.75.75 0 01.75.75v10.638l3.96-4.158a.75.75 0 111.08 1.04l-5.25 5.5a.75.75 0 01-1.08 0l-5.25-5.5a.75.75 0 111.08-1.04l3.96 4.158V3.75A.75.75 0 0110 3z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* ══════════════════════════════════════════════════════
     HERO STYLES — HIGH-TECH ATMOSPHERE & MODERN DYNAMICS
     ══════════════════════════════════════════════════════ */

  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 140px 1.5rem 80px;
    background-color: var(--ink);
    overflow: hidden;
    isolation: isolate;
  }

  /* ── Background Atmosphere & Beams ── */
  .hero-atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  /* Radiant Top Spotlight (Mint / Cyan / Electric Blue) */
  .spotlight-beam {
    position: absolute;
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 700px;
    background: radial-gradient(
      ellipse 60% 50% at 50% 20%,
      rgba(13, 236, 200, 0.22) 0%,
      rgba(56, 189, 248, 0.12) 35%,
      rgba(11, 15, 26, 0) 70%
    );
    filter: blur(40px);
    opacity: 0.95;
    animation: spotlightPulse 8s ease-in-out infinite alternate;
  }

  /* Secondary Warm Ambient Glow (NeuralJira Orange) */
  .spotlight-glow-secondary {
    position: absolute;
    top: 25%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(
      circle,
      rgba(249, 115, 22, 0.08) 0%,
      transparent 70%
    );
    filter: blur(60px);
    pointer-events: none;
  }

  /* Perspective Grid Lines */
  .grid-perspective {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    mask-image: radial-gradient(ellipse 70% 55% at 50% 40%, black 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 70% 55% at 50% 40%, black 20%, transparent 80%);
    opacity: 0.6;
  }

  /* Canvas Overlay */
  .particle-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  /* Floating Glyphs */
  .floating-glyphs {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .glyph {
    position: absolute;
    left: var(--x);
    top: var(--y);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(203, 213, 225, 0.35);
    background: rgba(26, 34, 53, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    backdrop-filter: blur(4px);
    letter-spacing: 0.04em;
    user-select: none;
    animation: glyphFloat 6s ease-in-out infinite alternate;
    animation-delay: var(--d);
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .glyph:hover {
    color: #0decc8;
    border-color: rgba(13, 236, 200, 0.3);
  }

  /* ── Hero Container ── */
  .hero-container {
    position: relative;
    z-index: 10;
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ── Trust Status Pill ── */
  .trust-pill-wrapper {
    margin-bottom: 1.75rem;
  }

  .trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.4rem 1rem;
    background: rgba(17, 24, 39, 0.75);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 9999px;
    box-shadow: 0 0 20px rgba(13, 236, 200, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    transition: all 0.25s ease;
    text-decoration: none;
  }

  .trust-pill:hover {
    border-color: rgba(13, 236, 200, 0.6);
    box-shadow: 0 0 30px rgba(13, 236, 200, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transform: translateY(-1px);
  }

  .pulse-indicator {
    position: relative;
    width: 8px;
    height: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: #0decc8;
    border-radius: 50%;
    box-shadow: 0 0 8px #0decc8;
  }

  .pulse-ring {
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(13, 236, 200, 0.35);
    animation: pulseGlow 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .trust-text {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--light);
    letter-spacing: 0.02em;
  }

  .trust-divider {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .trust-highlight {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    color: #0decc8;
    letter-spacing: 0.05em;
  }

  .trust-arrow {
    width: 14px;
    height: 14px;
    color: var(--muted);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .trust-pill:hover .trust-arrow {
    color: #0decc8;
    transform: translateX(2px);
  }

  /* ── Typography & Title Glow ── */
  .hero-title {
    font-size: clamp(2.4rem, 6.5vw, 4.8rem);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.035em;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .title-lead {
    color: var(--white);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .title-glow-wrap {
    position: relative;
    display: inline-block;
  }

  .title-glow-text {
    background: linear-gradient(135deg, #ffffff 15%, #0decc8 55%, #38bdf8 95%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 35px rgba(13, 236, 200, 0.4));
    position: relative;
    z-index: 1;
  }

  .title-glow-backdrop {
    position: absolute;
    inset: 10% 5%;
    background: radial-gradient(ellipse at center, rgba(13, 236, 200, 0.35) 0%, transparent 70%);
    filter: blur(35px);
    z-index: 0;
    pointer-events: none;
  }

  /* ── Subtitle ── */
  .hero-subtitle {
    font-size: clamp(1.02rem, 1.8vw, 1.25rem);
    line-height: 1.65;
    color: var(--text);
    max-width: 720px;
    margin: 0 auto 2.2rem;
    text-wrap: balance;
  }

  /* ── Feature Chips / Value Pills ── */
  .features-pills-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    margin-bottom: 2.75rem;
    max-width: 850px;
  }

  .feature-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    background: rgba(26, 34, 53, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    backdrop-filter: blur(8px);
    transition: all 0.25s ease;
  }

  .feature-chip:hover {
    background: rgba(26, 34, 53, 0.85);
    border-color: rgba(56, 189, 248, 0.35);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  .chip-icon {
    font-size: 0.95rem;
  }

  .chip-label {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--light);
    letter-spacing: 0.01em;
  }

  /* ── Action Buttons ── */
  .cta-actions {
    display: flex;
    gap: 1.15rem;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Primary High-Contrast Pill CTA */
  .btn-action-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem 0.5rem 0.45rem 1.6rem;
    background: #F8FAFC;
    color: #0B0F1A;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 0 25px rgba(255, 255, 255, 0.2), 0 4px 12px rgba(0, 0, 0, 0.3);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-action-primary:hover {
    background: #ffffff;
    box-shadow: 0 0 35px rgba(13, 236, 200, 0.45), 0 8px 24px rgba(0, 0, 0, 0.4);
    transform: translateY(-2px);
  }

  .btn-icon-circle {
    width: 36px;
    height: 36px;
    background: #0decc8;
    color: #0B0F1A;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease, background 0.25s ease;
  }

  .btn-action-primary:hover .btn-icon-circle {
    transform: translateX(3px);
    background: #38bdf8;
  }

  .btn-arrow-svg {
    width: 18px;
    height: 18px;
  }

  /* Secondary Glassmorphism Pill CTA */
  .btn-action-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.6rem;
    background: rgba(26, 34, 53, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--white);
    font-weight: 500;
    font-size: 0.95rem;
    border-radius: 9999px;
    text-decoration: none;
    backdrop-filter: blur(10px);
    transition: all 0.25s ease;
  }

  .btn-action-secondary:hover {
    background: rgba(37, 46, 66, 0.9);
    border-color: rgba(255, 255, 255, 0.25);
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* ── Bottom HUD Bar ── */
  .hero-bottom-hud {
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 10;
    font-size: 0.8rem;
    pointer-events: auto;
  }

  .hud-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--muted);
  }

  .hud-left {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .hud-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
  }

  .hud-value {
    color: var(--text);
  }

  .hud-center {
    display: flex;
    gap: 0.4rem;
  }

  .tech-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.15rem 0.45rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    color: var(--muted);
    transition: color 0.2s, border-color 0.2s;
  }

  .tech-badge:hover {
    color: #0decc8;
    border-color: rgba(13, 236, 200, 0.2);
  }

  .scroll-explore-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    transition: color 0.2s ease;
  }

  .scroll-explore-btn:hover {
    color: #0decc8;
  }

  .scroll-arrow {
    width: 14px;
    height: 14px;
    animation: bounceDown 2s infinite ease-in-out;
  }

  /* ── Keyframe Animations ── */
  @keyframes spotlightPulse {
    0% { transform: translateX(-50%) scale(0.95); opacity: 0.85; }
    100% { transform: translateX(-50%) scale(1.05); opacity: 1; }
  }

  @keyframes pulseGlow {
    0% { transform: scale(0.8); opacity: 0.8; }
    50% { transform: scale(1.8); opacity: 0; }
    100% { transform: scale(0.8); opacity: 0; }
  }

  @keyframes glyphFloat {
    0% { transform: translateY(0px) rotate(0deg); opacity: 0.35; }
    50% { transform: translateY(-12px) rotate(1deg); opacity: 0.65; }
    100% { transform: translateY(4px) rotate(-1deg); opacity: 0.35; }
  }

  @keyframes bounceDown {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(4px); }
    60% { transform: translateY(2px); }
  }

  /* ── Responsive Adaptations ── */
  @media (max-width: 900px) {
    .hud-left,
    .hud-center {
      display: none;
    }
    .hero-bottom-hud {
      justify-content: center;
      bottom: 16px;
    }
    .glyph-1, .glyph-4, .glyph-6, .glyph-7 {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 120px 1rem 70px;
    }
    .features-pills-row {
      gap: 0.45rem;
      margin-bottom: 2rem;
    }
    .feature-chip {
      font-size: 0.75rem;
      padding: 0.3rem 0.65rem;
    }
    .cta-actions {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }
    .btn-action-primary,
    .btn-action-secondary {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spotlight-beam,
    .pulse-ring,
    .glyph,
    .scroll-arrow {
      animation: none !important;
    }
  }
</style>

<script>
  // Lightweight, Butter-Smooth Constellation Particle Animation + Subtle Parallax
  (function initHeroAtmosphere() {
    const canvas = document.getElementById('hero-particle-canvas');
    if (!canvas || !(canvas instanceof HTMLCanvasElement)) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Respect user's motion preferences
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    let width = 0;
    let height = 0;
    let animationFrameId = 0;
    let mouseX = -9999;
    let mouseY = -9999;
    let isVisible = true;

    // Responsive canvas resizing
    function resizeCanvas() {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas.width = width * window.devicePixelRatio;
      canvas.height = height * window.devicePixelRatio;
      ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    }

    resizeCanvas();
    window.addEventListener('resize', resizeCanvas, { passive: true });

    // Node particle definition
    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      baseAlpha: number;
      color: string;
    }

    const particleCount = window.innerWidth < 768 ? 24 : 48;
    const particles: Particle[] = [];
    const colors = ['#0decc8', '#38bdf8', '#ffffff', '#fb923c'];

    for (let i = 0; i < particleCount; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.4,
        size: Math.random() * 2 + 1,
        baseAlpha: Math.random() * 0.4 + 0.15,
        color: colors[Math.floor(Math.random() * colors.length)]
      });
    }

    // Gentle mouse interaction tracking
    window.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
    }, { passive: true });

    window.addEventListener('mouseleave', () => {
      mouseX = -9999;
      mouseY = -9999;
    });

    // Pause animation when hero is off-screen to save CPU & battery
    const observer = new IntersectionObserver((entries) => {
      isVisible = entries[0].isIntersecting;
      if (isVisible && !animationFrameId) {
        render();
      }
    }, { threshold: 0.1 });

    const heroSection = document.getElementById('inicio');
    if (heroSection) observer.observe(heroSection);

    function render() {
      if (!isVisible) {
        animationFrameId = 0;
        return;
      }

      ctx.clearRect(0, 0, width, height);

      // Draw subtle connecting lines between close particles
      const connectionDist = 120;
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.hypot(dx, dy);

          if (dist < connectionDist) {
            const alpha = (1 - dist / connectionDist) * 0.12;
            ctx.strokeStyle = `rgba(13, 236, 200, ${alpha})`;
            ctx.lineWidth = 0.75;
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.stroke();
          }
        }
      }

      // Update & draw particles
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];

        // Move
        p.x += p.vx;
        p.y += p.vy;

        // Wrap boundaries
        if (p.x < 0) p.x = width;
        if (p.x > width) p.x = 0;
        if (p.y < 0) p.y = height;
        if (p.y > height) p.y = 0;

        // Mouse avoidance/repulsion
        const mdx = p.x - mouseX;
        const mdy = p.y - mouseY;
        const mdist = Math.hypot(mdx, mdy);
        if (mdist < 80) {
          p.x += (mdx / mdist) * 1.2;
          p.y += (mdy / mdist) * 1.2;
        }

        // Draw particle with soft halo
        ctx.fillStyle = p.color;
        ctx.globalAlpha = p.baseAlpha;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();

        // Extra glowing center for prominent particles
        if (p.size > 2) {
          ctx.globalAlpha = p.baseAlpha * 0.4;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size * 2.5, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      ctx.globalAlpha = 1;
      animationFrameId = requestAnimationFrame(render);
    }

    render();
  })();
</script>
